    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.10.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@propayn/typescript-config": "*",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.5"
